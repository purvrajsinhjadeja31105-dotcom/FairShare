# Copy to backend/.env for local development. Production values live in Render's environment settings.

PORT=5000
NODE_ENV=development
JWT_SECRET=any-long-random-string-for-local-dev

# Local Firestore emulator (started by `npm run dev` from the repo root).
# Leave this set locally so you never touch production data.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Links used in emails
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# How emails are delivered:
#   console = print verification/reset links in the terminal (default for local dev)
#   brevo   = real email via the Brevo HTTP API (use this in production on Render)
#   smtp    = real email via SMTP (blocked on Render's free tier)
EMAIL_MODE=console

# Brevo: API key from https://app.brevo.com/settings/keys/api
# EMAIL_FROM must be a sender address you verified in Brevo (Senders, Domains & Dedicated IPs)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=FairShare

# SMTP (only when EMAIL_MODE=smtp)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Production only (Render): Firebase service account JSON, raw or base64
# FIREBASE_SERVICE_ACCOUNT=
